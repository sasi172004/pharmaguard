# ============================================================
# PHARMAGUARD — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Server
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pharmaguard
DB_USER=pharmaguard_admin
DB_PASSWORD=your_secure_password_here
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_chars_long_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_minimum_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d

# File Storage
STORAGE_PROVIDER=local
# For local storage:
STORAGE_LOCAL_PATH=./uploads
# For AWS S3:
# STORAGE_PROVIDER=s3
# AWS_REGION=ap-south-1
# AWS_BUCKET_NAME=pharmaguard-data
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Encryption
ENCRYPTION_KEY=your_256_bit_encryption_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_TIMEOUT_MINUTES=30
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/pharmaguard.log
